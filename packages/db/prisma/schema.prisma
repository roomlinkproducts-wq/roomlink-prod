generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model announcements {
  announcement_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id        String   @db.Uuid
  title           String   @db.VarChar(255)
  content         String
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  users           users?   @relation(fields: [created_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  hotels          hotels   @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
}

model audit_logs {
  log_id       BigInt     @id @default(autoincrement())
  actor_id     String?    @db.Uuid
  actor_type   actor_type
  action       String     @db.VarChar(150)
  entity_type  String     @db.VarChar(100)
  entity_id    String?    @db.Uuid
  before_state Json?
  after_state  Json?
  ip_address   String?    @db.Inet
  created_at   DateTime   @default(now()) @db.Timestamptz(6)

  @@index([actor_id], map: "idx_audit_logs_actor")
  @@index([created_at], map: "idx_audit_logs_created")
  @@index([entity_type, entity_id], map: "idx_audit_logs_entity")
}

model buildings {
  building_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id    String   @db.Uuid
  name        String   @db.VarChar(100)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  hotels      hotels   @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms       rooms[]

  @@unique([hotel_id, name])
}

model call_logs {
  call_log_id      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id         String          @db.Uuid
  room_id          String?         @db.Uuid
  guest_session_id String?         @db.Uuid
  zego_room_id     String          @unique @db.VarChar(255)
  status           call_status     @default(ringing)
  answered_by      String?         @db.Uuid
  initiated_at     DateTime        @default(now()) @db.Timestamptz(6)
  answered_at      DateTime?       @db.Timestamptz(6)
  ended_at         DateTime?       @db.Timestamptz(6)
  hotels           hotels          @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms            rooms?          @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  guest_sessions   guest_sessions? @relation(fields: [guest_session_id], references: [session_id], onDelete: NoAction, onUpdate: NoAction)
  users            users?          @relation(fields: [answered_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hotel_id, initiated_at], map: "idx_call_logs_hotel_initiated_at")
  @@index([guest_session_id], map: "idx_call_logs_guest_session")
}

model conversations {
  conversation_id   String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id          String              @db.Uuid
  room_id           String?             @db.Uuid
  guest_id          String?             @db.Uuid
  guest_session_id  String?             @db.Uuid
  assigned_staff_id String?             @db.Uuid
  status            conversation_status @default(open)
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  closed_at         DateTime?           @db.Timestamptz(6)
  users             users?              @relation(fields: [assigned_staff_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  guests            guests?             @relation(fields: [guest_id], references: [guest_id], onDelete: NoAction, onUpdate: NoAction)
  guest_sessions    guest_sessions?     @relation(fields: [guest_session_id], references: [session_id], onDelete: NoAction, onUpdate: NoAction)
  hotels            hotels              @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms             rooms?              @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  messages          messages[]

  @@index([guest_session_id], map: "idx_conversations_guest_session")
}

model departments {
  department_id    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id         String             @db.Uuid
  name             String             @db.VarChar(100)
  is_custom        Boolean            @default(false)
  is_enabled       Boolean            @default(true)
  manager_id       String?            @db.Uuid
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  hotels           hotels             @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  users            users?             @relation(fields: [manager_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  requests         requests[]
  services         services[]
  user_departments user_departments[]

  @@unique([hotel_id, name])
}

model device_tokens {
  device_token_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id        String   @db.Uuid
  user_id         String   @db.Uuid
  platform        String   @db.VarChar(10)
  token           String   @unique @db.VarChar(500)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  hotels          hotels   @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  users           users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([hotel_id, user_id], map: "idx_device_tokens_hotel_user")
}

model guests {
  guest_id       String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id       String           @db.Uuid
  room_id        String?          @db.Uuid
  full_name      String?          @db.VarChar(150)
  phone          String?          @db.VarChar(20)
  email          String?          @db.VarChar(150)
  check_in_date  DateTime?        @db.Timestamptz(6)
  check_out_date DateTime?        @db.Timestamptz(6)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  conversations  conversations[]
  hotels         hotels           @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms          rooms?           @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  orders         orders[]
  requests       requests[]
  guest_sessions guest_sessions[]

  @@index([hotel_id, room_id], map: "idx_guests_hotel_room")
}

model guest_sessions {
  session_id                   String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id                     String               @db.Uuid
  room_id                      String               @db.Uuid
  guest_id                     String?              @db.Uuid
  session_token                String               @unique @db.VarChar(255)
  guest_mobile_e164            String?              @db.VarChar(20)
  issued_at                    DateTime             @default(now()) @db.Timestamptz(6)
  expires_at                   DateTime             @db.Timestamptz(6)
  status                       guest_session_status @default(active)
  terminated_by                String?              @db.Uuid
  terminated_at                DateTime?            @db.Timestamptz(6)
  failed_verification_attempts Int                  @default(0)
  verification_locked_until    DateTime?            @db.Timestamptz(6)
  hotels                       hotels               @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms                        rooms                @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  guests                       guests?              @relation(fields: [guest_id], references: [guest_id], onDelete: NoAction, onUpdate: NoAction)
  users                        users?               @relation(fields: [terminated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  requests                     requests[]
  orders                       orders[]
  conversations                conversations[]
  call_logs                    call_logs[]

  @@index([hotel_id, room_id], map: "idx_guest_sessions_hotel_room")
}

model hotels {
  hotel_id                                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                                        String                   @db.VarChar(200)
  hotel_code                                  String                   @unique @db.VarChar(50)
  brand                                       String?                  @db.VarChar(100)
  address_line                                String?                  @db.VarChar(255)
  city                                        String?                  @db.VarChar(100)
  state                                       String?                  @db.VarChar(100)
  country                                     String?                  @db.VarChar(100)
  pincode                                     String?                  @db.VarChar(20)
  contact_person                              String?                  @db.VarChar(150)
  phone                                       String?                  @db.VarChar(20)
  reception_contact                           String?                  @db.VarChar(20)
  room_service_contact                        String?                  @db.VarChar(20)
  email                                       String?                  @db.VarChar(150)
  logo_url                                    String?                  @db.VarChar(500)
  time_zone                                   String                   @default("Asia/Kolkata") @db.VarChar(60)
  check_in_time                               DateTime                 @default(dbgenerated("'14:00:00'::time without time zone")) @db.Time(6)
  check_out_time                              DateTime                 @default(dbgenerated("'11:00:00'::time without time zone")) @db.Time(6)
  description                                 String?
  website                                     String?                  @db.VarChar(255)
  breakfast_time                              DateTime?                @db.Time(6)
  restaurant_time                             DateTime?                @db.Time(6)
  legal_business_name                         String?                  @db.VarChar(200)
  gstin                                       String?                  @db.VarChar(15)
  pan                                         String?                  @db.VarChar(10)
  billing_address_line                        String?                  @db.VarChar(255)
  billing_city                                String?                  @db.VarChar(100)
  billing_state                               String?                  @db.VarChar(100)
  billing_pincode                             String?                  @db.VarChar(20)
  billing_country                             String?                  @db.VarChar(100)
  billing_email                               String?                  @db.VarChar(150)
  status                                      hotel_status             @default(pending)
  plan_id                                     String?                  @db.Uuid
  implementation_owner_id                     String?                  @db.Uuid
  created_at                                  DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                  DateTime                 @default(now()) @db.Timestamptz(6)
  announcements                               announcements[]
  buildings                                   buildings[]
  call_logs                                   call_logs[]
  conversations                               conversations[]
  departments                                 departments[]
  device_tokens                               device_tokens[]
  guests                                      guests[]
  guest_sessions                              guest_sessions[]
  hotel_settings                              hotel_settings?
  users_hotels_implementation_owner_idTousers users?                   @relation("hotels_implementation_owner_idTousers", fields: [implementation_owner_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction, map: "fk_hotels_implementation_owner")
  subscription_plans                          subscription_plans?      @relation(fields: [plan_id], references: [plan_id], onDelete: NoAction, onUpdate: NoAction)
  impersonation_sessions                      impersonation_sessions[]
  integrations                                integrations[]
  invoices                                    invoices[]
  menu_categories                             menu_categories[]
  menu_items                                  menu_items[]
  onboarding_tracker                          onboarding_tracker[]
  orders                                      orders[]
  requests                                    requests[]
  request_reminders                           request_reminders[]
  roles                                       roles[]
  room_types                                  room_types[]
  rooms                                       rooms[]
  services                                    services[]
  subscriptions                               subscriptions[]
  support_tickets                             support_tickets[]
  users_users_hotel_idTohotels                users[]                  @relation("users_hotel_idTohotels")
}

model hotel_settings {
  hotel_id                 String   @id @db.Uuid
  welcome_message          String?
  guest_instructions       String?
  wifi_name                String?  @db.VarChar(100)
  wifi_password            String?  @db.VarChar(100)
  notify_critical_requests Boolean  @default(true)
  notify_unassigned        Boolean  @default(true)
  notify_guest_messages    Boolean  @default(true)
  updated_at               DateTime @default(now()) @db.Timestamptz(6)
  hotels                   hotels   @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
}

model impersonation_sessions {
  session_id                                         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  super_admin_id                                     String    @db.Uuid
  hotel_id                                           String    @db.Uuid
  hotel_admin_id                                     String?   @db.Uuid
  started_at                                         DateTime  @default(now()) @db.Timestamptz(6)
  ended_at                                           DateTime? @db.Timestamptz(6)
  hotel_notified                                     Boolean   @default(false)
  users_impersonation_sessions_hotel_admin_idTousers users?    @relation("impersonation_sessions_hotel_admin_idTousers", fields: [hotel_admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  hotels                                             hotels    @relation(fields: [hotel_id], references: [hotel_id], onDelete: NoAction, onUpdate: NoAction)
  users_impersonation_sessions_super_admin_idTousers users     @relation("impersonation_sessions_super_admin_idTousers", fields: [super_admin_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
}

model integrations {
  integration_id   String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id         String?          @db.Uuid
  integration_type integration_type
  provider         String           @db.VarChar(100)
  config           Json             @default("{}")
  is_active        Boolean          @default(true)
  created_at       DateTime         @default(now()) @db.Timestamptz(6)
  hotels           hotels?          @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
}

model invoices {
  invoice_id      String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id        String         @db.Uuid
  subscription_id String?        @db.Uuid
  invoice_number  String         @unique @db.VarChar(50)
  amount          Decimal        @db.Decimal(12, 2)
  currency        String         @default("INR") @db.VarChar(3)
  status          invoice_status @default(draft)
  due_date        DateTime?      @db.Date
  paid_date       DateTime?      @db.Date
  created_at      DateTime       @default(now()) @db.Timestamptz(6)
  hotels          hotels         @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  subscriptions   subscriptions? @relation(fields: [subscription_id], references: [subscription_id], onDelete: NoAction, onUpdate: NoAction)
  payments        payments[]

  @@index([hotel_id], map: "idx_invoices_hotel")
}

model menu_categories {
  category_id   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id      String       @db.Uuid
  name          String       @db.VarChar(100)
  display_order Int          @default(0)
  hotels        hotels       @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  menu_items    menu_items[]

  @@unique([hotel_id, name])
}

model menu_items {
  item_id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id        String           @db.Uuid
  category_id     String           @db.Uuid
  name            String           @db.VarChar(150)
  description     String?
  price           Decimal          @db.Decimal(10, 2)
  image_url       String?          @db.VarChar(500)
  is_veg          Boolean?
  is_available    Boolean          @default(true)
  status          menu_item_status @default(active)
  created_at      DateTime         @default(now()) @db.Timestamptz(6)
  menu_categories menu_categories  @relation(fields: [category_id], references: [category_id], onDelete: Cascade, onUpdate: NoAction)
  hotels          hotels           @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  order_items     order_items[]

  @@index([hotel_id, category_id], map: "idx_menu_items_hotel_category")
}

model messages {
  message_id      String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id String        @db.Uuid
  sender_type     sender_type
  sender_id       String?       @db.Uuid
  content         String
  sent_at         DateTime      @default(now()) @db.Timestamptz(6)
  conversations   conversations @relation(fields: [conversation_id], references: [conversation_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([conversation_id], map: "idx_messages_conversation")
}

model onboarding_tracker {
  tracker_id String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id   String                 @db.Uuid
  step_name  String                 @db.VarChar(100)
  step_order Int
  status     onboarding_step_status @default(pending)
  updated_at DateTime               @default(now()) @db.Timestamptz(6)
  hotels     hotels                 @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([hotel_id, step_name])
}

model order_items {
  order_item_id String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  order_id      String     @db.Uuid
  item_id       String     @db.Uuid
  quantity      Int        @default(1)
  unit_price    Decimal    @db.Decimal(10, 2)
  menu_items    menu_items @relation(fields: [item_id], references: [item_id], onDelete: NoAction, onUpdate: NoAction)
  orders        orders     @relation(fields: [order_id], references: [order_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([order_id], map: "idx_order_items_order")
}

model orders {
  order_id         String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id         String          @db.Uuid
  room_id          String?         @db.Uuid
  guest_id         String?         @db.Uuid
  guest_session_id String?         @db.Uuid
  status           order_status    @default(pending)
  total_amount     Decimal         @default(0) @db.Decimal(12, 2)
  created_at       DateTime        @default(now()) @db.Timestamptz(6)
  delivered_at     DateTime?       @db.Timestamptz(6)
  order_items      order_items[]
  guests           guests?         @relation(fields: [guest_id], references: [guest_id], onDelete: NoAction, onUpdate: NoAction)
  guest_sessions   guest_sessions? @relation(fields: [guest_session_id], references: [session_id], onDelete: NoAction, onUpdate: NoAction)
  hotels           hotels          @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms            rooms?          @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([guest_session_id], map: "idx_orders_guest_session")
}

model payments {
  payment_id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invoice_id     String         @db.Uuid
  amount         Decimal        @db.Decimal(12, 2)
  method         String?        @db.VarChar(50)
  gateway        String?        @db.VarChar(50)
  gateway_txn_id String?        @db.VarChar(150)
  status         payment_status @default(pending)
  paid_at        DateTime?      @db.Timestamptz(6)
  created_at     DateTime       @default(now()) @db.Timestamptz(6)
  invoices       invoices       @relation(fields: [invoice_id], references: [invoice_id], onDelete: Cascade, onUpdate: NoAction)

  @@index([invoice_id], map: "idx_payments_invoice")
}

model permissions {
  permission_id    String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module           String             @unique @db.VarChar(100)
  role_permissions role_permissions[]
}

model qr_codes {
  qr_code_id   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  room_id      String    @db.Uuid
  code_value   String    @unique @db.VarChar(255)
  image_url    String?   @db.VarChar(500)
  generated_at DateTime  @default(now()) @db.Timestamptz(6)
  generated_by String?   @db.Uuid
  installed_at DateTime? @db.Timestamptz(6)
  is_active    Boolean   @default(true)
  users        users?    @relation(fields: [generated_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  rooms        rooms     @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction)
}

model requests {
  request_id             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id               String                   @db.Uuid
  room_id                String?                  @db.Uuid
  guest_id               String?                  @db.Uuid
  guest_session_id       String?                  @db.Uuid
  department_id          String?                  @db.Uuid
  request_type           String                   @db.VarChar(150)
  status                 request_status           @default(pending)
  priority               request_priority         @default(normal)
  notes                  String?
  assigned_to            String?                  @db.Uuid
  created_at             DateTime                 @default(now()) @db.Timestamptz(6)
  started_at             DateTime?                @db.Timestamptz(6)
  completed_at           DateTime?                @db.Timestamptz(6)
  accepted_at            DateTime?                @db.Timestamptz(6)
  cancelled_at           DateTime?                @db.Timestamptz(6)
  status_changed_at      DateTime                 @default(now()) @db.Timestamptz(6)
  users                  users?                   @relation(fields: [assigned_to], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  departments            departments?             @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction)
  guests                 guests?                  @relation(fields: [guest_id], references: [guest_id], onDelete: NoAction, onUpdate: NoAction)
  guest_sessions         guest_sessions?          @relation(fields: [guest_session_id], references: [session_id], onDelete: NoAction, onUpdate: NoAction)
  hotels                 hotels                   @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms                  rooms?                   @relation(fields: [room_id], references: [room_id], onDelete: NoAction, onUpdate: NoAction)
  request_status_history request_status_history[]
  request_reminders      request_reminders[]

  @@index([hotel_id, status], map: "idx_requests_hotel_status")
  @@index([guest_session_id], map: "idx_requests_guest_session")
  @@index([hotel_id, department_id, status], map: "idx_requests_hotel_department_status")
  @@index([assigned_to, status], map: "idx_requests_assigned_status")
  @@index([hotel_id, created_at], map: "idx_requests_hotel_created_at")
  @@index([hotel_id, status, completed_at], map: "idx_requests_hotel_status_completed_at")
}

model request_status_history {
  history_id                                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id                                      String          @db.Uuid
  from_status                                     request_status?
  to_status                                       request_status?
  to_assignee                                     String?         @db.Uuid
  changed_by                                      String?         @db.Uuid
  changed_at                                      DateTime        @default(now()) @db.Timestamptz(6)
  note                                            String?
  requests                                        requests        @relation(fields: [request_id], references: [request_id], onDelete: Cascade, onUpdate: NoAction)
  users_request_status_history_changed_byTousers  users?          @relation("request_status_history_changed_byTousers", fields: [changed_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  users_request_status_history_to_assigneeTousers users?          @relation("request_status_history_to_assigneeTousers", fields: [to_assignee], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([request_id], map: "idx_request_status_history_request")
}

/// One row per overdue reminder sent to reception for a still-open request.
/// `sequence` (1, 2, 3…) is unique per request, which is what makes the
/// reminder sweep safe to run concurrently from several polling tabs.
model request_reminders {
  reminder_id     String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id        String         @db.Uuid
  request_id      String         @db.Uuid
  sequence        Int
  status_at_send  request_status
  open_minutes    Int
  status_minutes  Int
  sent_at         DateTime       @default(now()) @db.Timestamptz(6)
  acknowledged_by String?        @db.Uuid
  acknowledged_at DateTime?      @db.Timestamptz(6)
  hotels          hotels         @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  requests        requests       @relation(fields: [request_id], references: [request_id], onDelete: Cascade, onUpdate: NoAction)
  users           users?         @relation(fields: [acknowledged_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([request_id, sequence])
  @@index([hotel_id, acknowledged_at], map: "idx_request_reminders_hotel_ack")
  @@index([hotel_id, sent_at], map: "idx_request_reminders_hotel_sent_at")
}

model role_permissions {
  role_id       String      @db.Uuid
  permission_id String      @db.Uuid
  can_view      Boolean     @default(false)
  can_create    Boolean     @default(false)
  can_edit      Boolean     @default(false)
  can_delete    Boolean     @default(false)
  permissions   permissions @relation(fields: [permission_id], references: [permission_id], onDelete: Cascade, onUpdate: NoAction)
  roles         roles       @relation(fields: [role_id], references: [role_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([role_id, permission_id])
}

model roles {
  role_id          String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id         String?            @db.Uuid
  name             String             @db.VarChar(100)
  is_system_role   Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  role_permissions role_permissions[]
  hotels           hotels?            @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  users            users[]

  @@unique([hotel_id, name])
}

model room_types {
  room_type_id String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id     String   @db.Uuid
  name         String   @db.VarChar(100)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  hotels       hotels   @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  rooms        rooms[]

  @@unique([hotel_id, name])
}

model rooms {
  room_id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id       String           @db.Uuid
  room_type_id   String?          @db.Uuid
  building_id    String?          @db.Uuid
  room_number    String           @db.VarChar(20)
  floor          String?          @db.VarChar(20)
  status         room_status      @default(active)
  created_at     DateTime         @default(now()) @db.Timestamptz(6)
  call_logs      call_logs[]
  conversations  conversations[]
  guests         guests[]
  orders         orders[]
  qr_codes       qr_codes[]
  requests       requests[]
  guest_sessions guest_sessions[]
  hotels         hotels           @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  room_types     room_types?      @relation(fields: [room_type_id], references: [room_type_id], onDelete: NoAction, onUpdate: NoAction)
  buildings      buildings?       @relation(fields: [building_id], references: [building_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([hotel_id, room_number])
  @@index([hotel_id], map: "idx_rooms_hotel")
}

model services {
  service_id    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id      String         @db.Uuid
  department_id String?        @db.Uuid
  name          String         @db.VarChar(150)
  description   String?
  status        service_status @default(active)
  created_at    DateTime       @default(now()) @db.Timestamptz(6)
  departments   departments?   @relation(fields: [department_id], references: [department_id], onDelete: NoAction, onUpdate: NoAction)
  hotels        hotels         @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
}

model subscription_plans {
  plan_id        String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String          @db.VarChar(100)
  is_custom      Boolean         @default(false)
  room_limit     Int?
  staff_limit    Int?
  price_amount   Decimal         @db.Decimal(12, 2)
  price_currency String          @default("INR") @db.VarChar(3)
  billing_cycle  billing_cycle   @default(monthly)
  features       Json            @default("{}")
  is_active      Boolean         @default(true)
  created_at     DateTime        @default(now()) @db.Timestamptz(6)
  hotels         hotels[]
  subscriptions  subscriptions[]
}

model subscriptions {
  subscription_id    String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id           String              @db.Uuid
  plan_id            String              @db.Uuid
  status             subscription_status @default(trial)
  start_date         DateTime            @db.Date
  end_date           DateTime?           @db.Date
  trial_end_date     DateTime?           @db.Date
  auto_renew         Boolean             @default(true)
  created_at         DateTime            @default(now()) @db.Timestamptz(6)
  updated_at         DateTime            @default(now()) @db.Timestamptz(6)
  invoices           invoices[]
  hotels             hotels              @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  subscription_plans subscription_plans  @relation(fields: [plan_id], references: [plan_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hotel_id], map: "idx_subscriptions_hotel")
}

model support_tickets {
  ticket_id                                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id                                 String            @db.Uuid
  raised_by                                String?           @db.Uuid
  category                                 String            @db.VarChar(100)
  subject                                  String            @db.VarChar(255)
  description                              String?
  status                                   ticket_status     @default(open)
  assigned_to                              String?           @db.Uuid
  created_at                               DateTime          @default(now()) @db.Timestamptz(6)
  resolved_at                              DateTime?         @db.Timestamptz(6)
  users_support_tickets_assigned_toTousers users?            @relation("support_tickets_assigned_toTousers", fields: [assigned_to], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  hotels                                   hotels            @relation(fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  users_support_tickets_raised_byTousers   users?            @relation("support_tickets_raised_byTousers", fields: [raised_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  ticket_messages                          ticket_messages[]
}

model ticket_messages {
  ticket_message_id String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ticket_id         String          @db.Uuid
  sender_id         String?         @db.Uuid
  content           String
  created_at        DateTime        @default(now()) @db.Timestamptz(6)
  users             users?          @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  support_tickets   support_tickets @relation(fields: [ticket_id], references: [ticket_id], onDelete: Cascade, onUpdate: NoAction)
}

model user_departments {
  user_id       String      @db.Uuid
  department_id String      @db.Uuid
  is_primary    Boolean     @default(false)
  assigned_at   DateTime    @default(now()) @db.Timestamptz(6)
  departments   departments @relation(fields: [department_id], references: [department_id], onDelete: Cascade, onUpdate: NoAction)
  users         users       @relation(fields: [user_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)

  @@id([user_id, department_id])
  @@index([department_id], map: "idx_user_departments_department")
  @@index([user_id], map: "idx_user_departments_user")
}

model users {
  user_id                                                             String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  hotel_id                                                            String?                  @db.Uuid
  role_id                                                             String                   @db.Uuid
  user_type                                                           user_type
  full_name                                                           String                   @db.VarChar(150)
  employee_id                                                         String?                  @db.VarChar(50)
  email                                                               String                   @unique @db.VarChar(150)
  phone                                                               String?                  @db.VarChar(20)
  password_hash                                                       String                   @db.VarChar(255)
  status                                                              user_status              @default(invited)
  mfa_enabled                                                         Boolean                  @default(false)
  mfa_secret                                                          String?                  @db.VarChar(255)
  last_login_at                                                       DateTime?                @db.Timestamptz(6)
  invited_by                                                          String?                  @db.Uuid
  created_at                                                          DateTime                 @default(now()) @db.Timestamptz(6)
  updated_at                                                          DateTime                 @default(now()) @db.Timestamptz(6)
  announcements                                                       announcements[]
  call_logs                                                           call_logs[]
  conversations                                                       conversations[]
  device_tokens                                                       device_tokens[]
  hotels_hotels_implementation_owner_idTousers                        hotels[]                 @relation("hotels_implementation_owner_idTousers")
  impersonation_sessions_impersonation_sessions_hotel_admin_idTousers impersonation_sessions[] @relation("impersonation_sessions_hotel_admin_idTousers")
  impersonation_sessions_impersonation_sessions_super_admin_idTousers impersonation_sessions[] @relation("impersonation_sessions_super_admin_idTousers")
  qr_codes                                                            qr_codes[]
  requests                                                            requests[]
  guest_sessions                                                      guest_sessions[]
  departments_managed                                                 departments[]
  request_status_history_request_status_history_changed_byTousers     request_status_history[] @relation("request_status_history_changed_byTousers")
  request_status_history_request_status_history_to_assigneeTousers    request_status_history[] @relation("request_status_history_to_assigneeTousers")
  request_reminders_acknowledged                                      request_reminders[]
  support_tickets_support_tickets_assigned_toTousers                  support_tickets[]        @relation("support_tickets_assigned_toTousers")
  support_tickets_support_tickets_raised_byTousers                    support_tickets[]        @relation("support_tickets_raised_byTousers")
  ticket_messages                                                     ticket_messages[]
  user_departments                                                    user_departments[]
  hotels_users_hotel_idTohotels                                       hotels?                  @relation("users_hotel_idTohotels", fields: [hotel_id], references: [hotel_id], onDelete: Cascade, onUpdate: NoAction)
  users                                                               users?                   @relation("usersTousers", fields: [invited_by], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  other_users                                                         users[]                  @relation("usersTousers")
  roles                                                               roles                    @relation(fields: [role_id], references: [role_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([hotel_id], map: "idx_users_hotel")
  @@index([role_id], map: "idx_users_role")
}

enum actor_type {
  super_admin
  hotel_admin
  hotel_staff
  system
  guest
}

enum billing_cycle {
  monthly
  yearly
}

enum call_status {
  ringing
  answered
  missed
  declined
  ended
}

enum conversation_status {
  open
  closed
}

enum hotel_status {
  pending
  onboarding
  trial
  active
  suspended
  churned
}

enum integration_type {
  pms
  payment_gateway
  communication
}

enum guest_session_status {
  active
  expired
  terminated
}

enum invoice_status {
  draft
  sent
  paid
  overdue
  refunded
  cancelled
}

enum menu_item_status {
  active
  inactive
}

enum onboarding_step_status {
  pending
  in_progress
  complete
}

enum order_status {
  pending
  preparing
  out_for_delivery
  delivered
  cancelled
}

enum payment_status {
  pending
  success
  failed
  refunded
}

enum request_priority {
  normal
  high
  urgent
}

enum request_status {
  pending
  pending_acceptance
  assigned
  in_progress
  completed
  cancelled
  escalated
}

enum room_status {
  active
  inactive
  maintenance
}

enum sender_type {
  guest
  staff
  system
}

enum service_status {
  active
  inactive
}

enum subscription_status {
  trial
  active
  paused
  cancelled
  expired
}

enum ticket_status {
  open
  assigned
  in_progress
  waiting_for_hotel
  resolved
  closed
}

enum user_status {
  active
  invited
  suspended
  disabled
}

enum user_type {
  super_admin
  support_staff
  hotel_admin
  hotel_staff
}
